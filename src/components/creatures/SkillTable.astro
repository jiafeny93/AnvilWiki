---
/**
 * Full skill table (Combat + Innate) for the Aniimo skills system page.
 *
 * Data-driven from src/data/creatureSkills.json (regenerated by
 * Aniimo/gen_system_tables.py). Skill names, costs and power values are
 * official-index data and identical in every locale; only the surrounding
 * labels localize.
 */
import skills from '~/data/creatureSkills.json';
import stats from '~/data/creatureStats.json';
import { detailPath } from '~/lib/url';
import type { Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
  /** 'Combat' | 'Innate' — which section to render. */
  section: 'Combat' | 'Innate';
}
const { locale, section } = Astro.props;

const slugByName = new Map(stats.map((c) => [c.name, c.slug]));

type Row = Record<string, string>;
const T: Record<Locale, Row> = {
  en: { skill: 'Skill', cost: 'Cost', power: 'Power', creatures: 'Used by', all: 'All 94 creatures', many: (n: number) => `${n} creatures` },
  zh: { skill: '技能', cost: '费用', power: '威力', creatures: '持有生物', all: '全部 94 只生物', many: (n: number) => `${n} 只生物` },
  ja: { skill: 'スキル', cost: 'コスト', power: '威力', creatures: '覚えるクリーチャー', all: '全94体', many: (n: number) => `${n}体` },
  ko: { skill: '스킬', cost: '코스트', power: '위력', creatures: '습득 크리처', all: '전 94종', many: (n: number) => `${n}종` },
};
const t = T[locale];

const rows = skills.filter((s) => s.tab === section);
const shown = (owners: string[]) =>
  owners.length >= 90 ? t.all : owners.length > 6 ? t.many(owners.length) : null;
---

<table class="skill-table w-full text-sm" data-skill-table data-section={section.toLowerCase()}>
  <thead>
    <tr>
      <th data-key="name" data-type="text">{t.skill}</th>
      <th data-key="cost" data-type="num" class="text-right">{t.cost}</th>
      <th data-key="power" data-type="num" class="text-right">{t.power}</th>
      <th data-key="owners" data-type="num" class="sort-disabled">{t.creatures}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((s) => (
      <tr data-name={s.name} data-cost={s.cost} data-power={s.power} data-owners={s.owners.length}>
        <td class="font-medium">{s.name}</td>
        <td class="text-right">{s.cost}</td>
        <td class="text-right">{s.power}</td>
        <td>
          {shown(s.owners) ? (
            <span class="text-foreground/75">{shown(s.owners)}</span>
          ) : (
            <span class="flex flex-wrap gap-x-2">
              {s.owners.map((o) => (
                <a href={detailPath('creatures', `aniimo-${slugByName.get(o) ?? o.toLowerCase()}`, locale)}>{o}</a>
              ))}
            </span>
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>

<script>
  // Same click-to-sort contract as StatTable — see that component for notes.
  for (const table of document.querySelectorAll<HTMLTableElement>('[data-skill-table]')) {
    const tbody = table.tBodies[0];
    if (!tbody) continue;
    const headers = table.querySelectorAll('thead th[data-key]:not(.sort-disabled)');
    for (const th of headers) {
      th.setAttribute('role', 'button');
      th.setAttribute('tabindex', '0');
      const key = th.dataset.key!;
      const isNum = th.dataset.type === 'num';
      let dir = key === 'name' ? 1 : -1;
      const apply = () => {
        const rows = Array.from(tbody.rows);
        rows.sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          const cmp = isNum
            ? (parseFloat(av) || 0) - (parseFloat(bv) || 0)
            : av.localeCompare(bv);
          return cmp * dir;
        });
        for (const r of rows) tbody.appendChild(r);
        for (const h of headers) {
          h.removeAttribute('aria-sort');
          h.textContent = h.textContent!.replace(/ [▲▼]$/, '');
        }
        th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
        th.textContent = `${th.textContent} ${dir === 1 ? '▲' : '▼'}`;
        dir = -dir;
      };
      th.addEventListener('click', apply);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); apply(); }
      });
    }
  }
</script>

<style>
  .skill-table { border-collapse: collapse; min-width: 40rem; }
  .skill-table th, .skill-table td { padding: 0.3rem 0.6rem; border-bottom: 1px solid hsl(var(--border) / 0.6); }
  .skill-table thead th {
    position: sticky; top: 0; background: hsl(var(--card));
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em;
    white-space: nowrap; cursor: pointer; user-select: none;
  }
  .skill-table thead th.sort-disabled { cursor: default; }
  .skill-table tbody tr:hover { background: hsl(var(--muted) / 0.5); }
</style>
