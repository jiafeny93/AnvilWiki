---
/**
 * Trait reverse-lookup table for the Aniimo traits system page: every unique
 * trait with its official description and the creatures that carry it.
 *
 * Data-driven from src/data/creatureTraits.json (regenerated by
 * Aniimo/gen_system_tables.py). Trait effects are official-index English
 * text; creature links localize per locale.
 */
import traits from '~/data/creatureTraits.json';
import stats from '~/data/creatureStats.json';
import { detailPath } from '~/lib/url';
import type { Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const slugByName = new Map(stats.map((c) => [c.name, c.slug]));

type Row = Record<string, string>;
const T: Record<Locale, Row> = {
  en: { trait: 'Trait', effect: 'Effect (official text)', creatures: 'Creatures with this trait', many: (n: number) => `${n} creatures` },
  zh: { trait: '特性', effect: '效果（官方原文）', creatures: '持有生物', many: (n: number) => `${n} 只生物` },
  ja: { trait: '特性', effect: '効果（公式原文）', creatures: '持つクリーチャー', many: (n: number) => `${n}体` },
  ko: { trait: '특성', effect: '효과 (공식 원문)', creatures: '보유 크리처', many: (n: number) => `${n}종` },
};
const t = T[locale];
---

<table class="trait-table w-full text-sm">
  <thead>
    <tr>
      <th>{t.trait}</th>
      <th>{t.effect}</th>
      <th>{t.creatures}</th>
    </tr>
  </thead>
  <tbody>
    {traits.map((tr) => (
      <tr>
        <td class="font-medium whitespace-nowrap">{'['}{tr.name}{']'}</td>
        <td class="text-foreground/85">{tr.desc}</td>
        <td>
          {tr.owners.length > 6 ? (
            <span class="text-foreground/75">{t.many(tr.owners.length)}</span>
          ) : (
            <span class="flex flex-wrap gap-x-2">
              {tr.owners.map((o) => (
                <a href={detailPath('creatures', `aniimo-${slugByName.get(o) ?? o.toLowerCase()}`, locale)}>{o}</a>
              ))}
            </span>
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .trait-table { border-collapse: collapse; min-width: 48rem; }
  .trait-table th, .trait-table td { padding: 0.3rem 0.6rem; border-bottom: 1px solid hsl(var(--border) / 0.6); vertical-align: top; }
  .trait-table thead th {
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .trait-table tbody tr:hover { background: hsl(var(--muted) / 0.5); }
</style>
