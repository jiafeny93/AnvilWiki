---
/**
 * Sortable 6-stat roster table for the creatures-list pages.
 *
 * Data-driven from src/data/creatureStats.json (regenerated by
 * Aniimo/gen_system_tables.py from the official wiki snapshot). Numbers come
 * straight from the official Aniimo Index; stat labels follow the same
 * localized wording as the per-creature base-stat tables.
 */
import stats from '~/data/creatureStats.json';
import { detailPath } from '~/lib/url';
import type { Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const ELEM: Record<string, Partial<Record<Locale, string>>> = {
  Fire: { zh: '火', ja: '炎', ko: '화염' },
  Water: { zh: '水', ja: '水', ko: '물' },
  Grass: { zh: '草', ja: '草', ko: '풀' },
  Lightning: { zh: '雷', ja: '雷', ko: '번개' },
  Ice: { zh: '冰', ja: '氷', ko: '얼음' },
  Earth: { zh: '土', ja: '土', ko: '땅' },
  Wind: { zh: '风', ja: '風', ko: '바람' },
  Light: { zh: '光', ja: '光', ko: '빛' },
  Dark: { zh: '暗', ja: '闇', ko: '어둠' },
};
const elem = (e: string) => (locale === 'en' ? e : ELEM[e]?.[locale] ?? e);

type Row = Record<string, string>;
const T: Record<Locale, Row> = {
  en: { no: 'No.', creature: 'Creature', element: 'Element', role: 'Role',
        hp: 'HP', atk: 'ATK', pdef: 'P.DEF', mdef: 'M.DEF', brk: 'BREAK', regen: 'REGEN', total: 'Total',
        habitats: 'Habitats', hint: 'Click any header to sort — tap again to reverse.' },
  zh: { no: '编号', creature: '生物', element: '属性', role: '定位',
        hp: '生命', atk: '攻击', pdef: '物理防御', mdef: '法术防御', brk: '破击', regen: '回复', total: '总和',
        habitats: '栖息地', hint: '点击任意表头排序，再点一次反向排序。' },
  ja: { no: 'No.', creature: 'クリーチャー', element: '属性', role: 'ロール',
        hp: 'HP', atk: '攻撃', pdef: '物理防御', mdef: '魔法防御', brk: 'ブレイク', regen: '回復', total: '合計',
        habitats: '生息地', hint: '見出しをクリックで並べ替え（もう一度で逆順）。' },
  ko: { no: 'No.', creature: '크리처', element: '속성', role: '역할',
        hp: 'HP', atk: '공격', pdef: '물리방어', mdef: '마법방어', brk: '브레이크', regen: '회복', total: '합계',
        habitats: '서식지', hint: '제목을 클릭하면 정렬됩니다(한 번 더 클릭하면 역순).' },
};
const t = T[locale];
---

<div class="stat-table-wrap">
  <p class="mb-2 text-sm text-foreground/70">{t.hint}</p>
  <table class="stat-table w-full text-sm" data-stat-table>
    <thead>
      <tr>
        <th data-key="no" data-type="num" aria-sort="ascending">{t.no}</th>
        <th data-key="name" data-type="text">{t.creature}</th>
        <th data-key="elements" data-type="text">{t.element}</th>
        <th data-key="role" data-type="text">{t.role}</th>
        <th data-key="hp" data-type="num" class="text-right">{t.hp}</th>
        <th data-key="atk" data-type="num" class="text-right">{t.atk}</th>
        <th data-key="pdef" data-type="num" class="text-right">{t.pdef}</th>
        <th data-key="mdef" data-type="num" class="text-right">{t.mdef}</th>
        <th data-key="brk" data-type="num" class="text-right">{t.brk}</th>
        <th data-key="regen" data-type="num" class="text-right">{t.regen}</th>
        <th data-key="total" data-type="num" class="text-right font-bold">{t.total}</th>
        <th data-key="habitats" data-type="text" class="sort-disabled">{t.habitats}</th>
      </tr>
    </thead>
    <tbody>
      {stats.map((c) => (
        <tr
          data-no={c.no}
          data-name={c.name}
          data-elements={c.elements.join('/')}
          data-role={c.role}
          data-hp={c.hp} data-atk={c.atk} data-pdef={c.pdef} data-mdef={c.mdef}
          data-brk={c.brk} data-regen={c.regen} data-total={c.total}
          data-habitats={c.habitats}
        >
          <td class="whitespace-nowrap">{c.no}</td>
          <td class="whitespace-nowrap">
            <a href={detailPath('creatures', `aniimo-${c.slug}`, locale)} class="flex items-center gap-2">
              <img
                src={`/images/creatures/${c.slug}-mini.webp`}
                alt={`${c.name} Aniimo avatar`}
                width="24" height="24" loading="lazy" class="rounded-sm"
              />
              <span class="font-medium">{c.name}</span>
            </a>
          </td>
          <td class="whitespace-nowrap">{c.elements.map(elem).join('/')}</td>
          <td class="whitespace-nowrap">{c.role}</td>
          <td class="text-right">{c.hp}</td>
          <td class="text-right">{c.atk}</td>
          <td class="text-right">{c.pdef}</td>
          <td class="text-right">{c.mdef}</td>
          <td class="text-right">{c.brk}</td>
          <td class="text-right">{c.regen}</td>
          <td class="text-right font-semibold">{c.total}</td>
          <td class="text-foreground/80">{c.habitats}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Generic click-to-sort for [data-stat-table]. Sort keys live on <tr>
  // data-* attributes, so re-sorting is pure DOM row reordering — no rebuild.
  for (const table of document.querySelectorAll<HTMLTableElement>('[data-stat-table]')) {
    const tbody = table.tBodies[0];
    if (!tbody) continue;
    const headers = table.querySelectorAll('thead th[data-key]:not(.sort-disabled)');
    for (const th of headers) {
      th.setAttribute('role', 'button');
      th.setAttribute('tabindex', '0');
      const key = th.dataset.key!;
      const isNum = th.dataset.type === 'num';
      let dir = th === headers[0] ? 1 : -1; // No. column starts ascending, others descending
      const apply = () => {
        const rows = Array.from(tbody.rows);
        rows.sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          const cmp = isNum
            ? (parseFloat(av) || 0) - (parseFloat(bv) || 0)
            : av.localeCompare(bv);
          return cmp * dir;
        });
        for (const r of rows) tbody.appendChild(r);
        for (const h of headers) {
          h.removeAttribute('aria-sort');
          h.textContent = h.textContent!.replace(/ [▲▼]$/, '');
        }
        th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
        th.textContent = `${th.textContent} ${dir === 1 ? '▲' : '▼'}`;
        dir = -dir;
      };
      th.addEventListener('click', apply);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); apply(); }
      });
    }
  }
</script>

<style>
  .stat-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .stat-table { border-collapse: collapse; min-width: 64rem; }
  .stat-table th, .stat-table td { padding: 0.35rem 0.6rem; border-bottom: 1px solid hsl(var(--border) / 0.6); }
  .stat-table thead th {
    position: sticky; top: 0; background: hsl(var(--card));
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em;
    white-space: nowrap; cursor: pointer; user-select: none;
  }
  .stat-table thead th.sort-disabled { cursor: default; }
  .stat-table tbody tr:hover { background: hsl(var(--muted) / 0.5); }
  @media (prefers-reduced-motion: no-preference) {
    .stat-table thead th:hover { color: hsl(var(--brand)); }
  }
</style>
