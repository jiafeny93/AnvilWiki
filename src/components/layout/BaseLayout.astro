---
/**
 * BaseLayout — the root <html> + <head> shell shared by every page.
 *
 * Responsibilities:
 *   - <html lang> and theme class (no FOUC via inline script)
 *   - global <head>: charset, viewport, title template, description, og/twitter defaults
 *   - Organization JSON-LD (every page)
 *   - global styles
 *
 * Pages should wrap themselves in LocaleLayout (which wraps this), not call this directly.
 */
import '~/styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import { site, siteUrl } from '~/config/site';
import { organizationJsonLd } from '~/lib/seo';
import JsonLd from '~/components/seo/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  locale: string;
  /** Per-page alternates for hreflang. */
  alternates?: Array<{ hreflang: string; href: string }>;
  /** og:image override (absolute URL). Defaults to hero.webp. */
  image?: string;
  /** Optional extra JSON-LD objects to inject (WebSite, Article, etc.). */
  jsonLd?: Record<string, unknown>[];
  /** Set to true on article pages for og:type=article. */
  article?: boolean;
}

const {
  title,
  description,
  locale,
  alternates = [],
  image = `${siteUrl}/images/hero.webp`,
  jsonLd = [],
  article = false,
} = Astro.props;

const fullTitle = title.includes(site.name) ? title : `${title} — ${site.name}`;
const orgJsonLd = organizationJsonLd();

// Optional analytics / verification / ads (env-var gated — empty = not injected).
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT as string | undefined;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />

    {/* SPA-style seamless page navigation. */}
    <ClientRouter />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />

    {/* hreflang alternates */}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${siteUrl}${Astro.url.pathname.replace(/^\/(en|zh)/, '')}`}
    />

    {/* Open Graph */}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(site.ogImageWidth)} />
    <meta property="og:image:height" content={String(site.ogImageHeight)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).href} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale} />

    {/* Twitter */}
    <meta name="twitter:card" content={article ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {/* Theme color (browser chrome) */}
    <meta name="theme-color" content="hsl(var(--brand))" />

    {/* Google Search Console verification (optional) */}
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    {/* Google Analytics (optional, env-var gated) */}
    {gaId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    )}
    {gaId && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}

    {/* JSON-LD: Organization (global) + any page-specific */}
    <JsonLd data={orgJsonLd} />
    {jsonLd.map((d) => <JsonLd data={d} />)}

    {/* Google AdSense loader (optional, env-var gated) */}
    {adsenseClient && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}

    {/* No-FOUC theme init — runs before first paint. */}
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    {/* Reading progress bar (width driven by the effects script). */}
    <div id="reading-progress" class="reading-progress" aria-hidden="true" transition:persist="reading-progress"></div>
    <slot />

    {/* Premium effects: card mouse-spotlight, scroll-reveal, progress bar.
        Event-delegated so it survives ClientRouter navigations. */}
    <script>
      // Card mouse-spotlight — delegation, no per-card binding needed.
      document.addEventListener('pointermove', (e) => {
        const target = e.target as Element | null;
        const card = target?.closest?.('.card');
        if (!(card instanceof HTMLElement)) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
        card.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
      });

      // Reading progress bar.
      const onScroll = () => {
        const h = document.documentElement;
        const bar = document.getElementById('reading-progress');
        if (!bar) return;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = `${max > 0 ? (h.scrollTop / max) * 100 : 0}%`;
      };
      document.addEventListener('scroll', onScroll, { passive: true });

      // Scroll-reveal — observe .reveal elements, reveal once on enter.
      let io: IntersectionObserver | undefined;
      const setupReveal = () => {
        io?.disconnect();
        io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (en.isIntersecting) {
                en.target.classList.add('revealed');
                io?.unobserve(en.target);
              }
            }
          },
          { threshold: 0.08 },
        );
        document.querySelectorAll('.reveal:not(.revealed)').forEach((el) => io?.observe(el));
      };

      const init = () => {
        onScroll();
        setupReveal();
      };
      init();
      // Re-run after each ClientRouter navigation.
      document.addEventListener('astro:page-load', init);
    </script>
  </body>
</html>
