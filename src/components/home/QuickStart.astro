---
/**
 * QuickStart — prominent icon-card grid of the 4 things a new player needs.
 *
 * Renders `home.start.cards` as large, clickable tiles (2×2 on desktop,
 * single column on mobile). Each card carries an icon, title, one-line
 * description, and a theme-colored arrow — modeled on the "quick actions"
 * pattern used by successful game-wiki homepages.
 *
 * Placed immediately after the Hero so first-time visitors see their
 * next step without scrolling past marketing copy.
 */
import { Icon } from 'astro-icon/components';
import { type Locale } from '~/i18n/routing';
import { categoryArt } from '~/lib/categoryArt';
import { localizePath } from '~/lib/url';

interface StartCard {
  number: string;
  title: string;
  description: string;
  icon: string;
  href: string;
}

interface Props {
  locale: Locale;
  badge?: string;
  title?: string;
  cards?: StartCard[];
}
const { locale, badge = 'Start Here', title = 'Quick Start', cards = [] } = Astro.props;
---
{cards.length > 0 && (
  <section class="section reveal border-t border-border">
    <p class="text-sm font-semibold uppercase tracking-wider text-foreground">{badge}</p>
    <h2 class="mt-1 text-2xl font-bold tracking-tight md:text-3xl">{title}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 md:mt-8">
      {cards.map((card: StartCard) => (
        <a
          href={localizePath(card.href, locale)}
          class="card group flex flex-col overflow-hidden"
        >
          {/* Category art header — official promotional art per section. */}
          <div class="relative h-32 overflow-hidden">
            <img
              src={categoryArt(card.href.replace(/^\//, '').split('/')[0] ?? 'guides')}
              alt=""
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
            />
            <span class="absolute right-3 top-3 rounded-full bg-black/60 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-sm">
              {card.number}
            </span>
            <span class="absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-black/50 to-transparent" />
            <span class="absolute bottom-2 left-3 flex h-9 w-9 items-center justify-center rounded-lg bg-white/90 text-nav shadow-sm backdrop-blur-sm">
              <Icon name={card.icon} class="h-5 w-5" />
            </span>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-semibold leading-snug">{card.title}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{card.description}</p>
            <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-foreground hover:text-nav">
              <span class="border-b border-transparent transition group-hover:border-nav">Open</span>
              <Icon
                name="lucide:arrow-right"
                class="h-3 w-3 transition group-hover:translate-x-0.5"
              />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
