---
/**
 * Interactive Team Coverage Checker (/guides/aniimo-team-coverage/).
 *
 * Pick 1-6 creatures → static-rendered default analysis + vanilla JS recompute:
 *   - offensive coverage: best multiplier the team can hit each of the 9
 *     defender elements for, and which member provides it;
 *   - defensive exposure: which incoming elements the team takes 1.6x from;
 *   - gap-filling suggestions pulled from the 94-creature roster.
 *
 * Data-driven from src/data/teamCoverage.json (generated by
 * Aniimo/gen_team_coverage_data.py from types.json + creatureStats.json).
 * Dual-element creatures are scored per element — official defensive stacking
 * is TBA, mirrored in the visible note below the second table.
 */
import data from '~/data/teamCoverage.json';
import { detailPath } from '~/lib/url';
import type { Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// UI copy lives in the shared locales files (teamCoverage namespace) so all
// four language pages of the tool share one source of truth.
import en from '~/locales/en.json';
import zh from '~/locales/zh.json';
import ja from '~/locales/ja.json';
import ko from '~/locales/ko.json';
const DICT = { en, zh, ja, ko } as const;
const t = (DICT[locale] as Record<string, Record<string, string>>).teamCoverage;

const ELEM: Record<string, Partial<Record<Locale, string>>> = {
  Fire: { zh: '火', ja: '炎', ko: '화염' },
  Water: { zh: '水', ja: '水', ko: '물' },
  Grass: { zh: '草', ja: '草', ko: '풀' },
  Lightning: { zh: '雷', ja: '雷', ko: '번개' },
  Ice: { zh: '冰', ja: '氷', ko: '얼음' },
  Earth: { zh: '土', ja: '土', ko: '땅' },
  Wind: { zh: '风', ja: '風', ko: '바람' },
  Light: { zh: '光', ja: '光', ko: '빛' },
  Dark: { zh: '暗', ja: '闇', ko: '어둠' },
};
const COLOR: Record<string, string> = {
  Fire: '#f97316', Water: '#3b82f6', Grass: '#22c55e', Lightning: '#eab308',
  Ice: '#38bdf8', Earth: '#b45309', Wind: '#2dd4bf', Light: '#cbd5e1', Dark: '#71717a',
};
const elem = (e: string) => (locale === 'en' ? e : ELEM[e]?.[locale] ?? e);
const dots = (els: string[]) =>
  els.map((e) => `<span title="${e}" style="color:${COLOR[e]}">●</span>`).join(' ');

// --- Same algorithm as the client script below (kept in sync) -------------
type Member = { slug: string; name: string; no: string; elements: string[]; total: number };
const matrix = data.matrix as Record<string, Record<string, number>>;
const S = data.super, R = data.resisted;

function analyze(team: Member[]) {
  const offense = data.elements.map((d: string) => {
    let best = 1, from = '';
    for (const m of team) {
      for (const a of m.elements) {
        const v = matrix[a][d];
        if (v > best) { best = v; from = m.name; }
      }
    }
    const status = best === S ? 'super' : best === R ? 'resisted' : 'neutral';
    return { d, best, from, status };
  });
  const defense = data.elements.map((a: string) => {
    const weak: string[] = [], resist: string[] = [];
    for (const m of team) {
      if (m.elements.some((e) => matrix[a][e] === S)) weak.push(m.name);
      if (m.elements.some((e) => matrix[a][e] === R)) resist.push(m.name);
    }
    return { a, weak, resist };
  });
  const inTeam = new Set(team.map((m) => m.slug));
  const byTotal = (x: Member, y: Member) => y.total - x.total;
  const roster = data.creatures as Member[];
  const sugOff = offense
    .filter((o) => o.best < S)
    .map((o) => ({
      elem: o.d,
      picks: roster
        .filter((c) => !inTeam.has(c.slug) && c.elements.some((a) => matrix[a][o.d] === S))
        .sort(byTotal).slice(0, 3),
    }));
  const sugDef = defense
    .filter((d) => d.weak.length >= 2)
    .map((d) => ({
      elem: d.a, n: d.weak.length,
      picks: roster
        .filter((c) => !inTeam.has(c.slug) && c.elements.some((e) => matrix[d.a][e] === R))
        .sort(byTotal).slice(0, 3),
    }));
  return { offense, defense, sugOff, sugDef };
}

const bySlug = new Map((data.creatures as Member[]).map((c) => [c.slug, c]));
const preset = ['emberpup', 'eko', 'eklue', 'helmut']
  .map((s) => bySlug.get(s))
  .filter(Boolean) as Member[];
const result = analyze(preset);

const statusLabel = { super: t.super, neutral: t.neutral, resisted: t.resisted } as const;
const statusColor = { super: '#22c55e', neutral: '#eab308', resisted: '#ef4444' } as const;
const pickHref = (slug: string) => detailPath('creatures', `aniimo-${slug}`, locale);
const fmt = (v: number) => `${v}×`;

// Client payload: UI strings + localized element names + link prefix.
// (elem itself is a closure — JSON can't carry functions, so ship the map.)
const clientI18n = {
  t,
  elemMap: Object.fromEntries((data.elements as string[]).map((e) => [e, elem(e)])),
  preset: preset.map((m) => m.slug),
  pathPrefix: locale === 'en' ? '/creatures/aniimo-' : `/${locale}/creatures/aniimo-`,
};
---

<div class="tcover" data-team-coverage>
  <p class="mb-2 text-sm font-medium">{t.pick}</p>
  <input
    type="search"
    data-tc-search
    placeholder={t.search}
    aria-label={t.search}
    class="mb-2 w-full rounded-md border border-border bg-background px-3 py-2 text-sm"
  />
  <div class="tcover-grid" data-tc-grid role="listbox" aria-multiselectable="true" aria-label={t.pick}>
    {(data.creatures as Member[]).map((c) => (
      <button
        type="button"
        role="option"
        data-slug={c.slug}
        data-name={c.name.toLowerCase()}
        aria-selected={preset.some((p) => p.slug === c.slug) ? 'true' : 'false'}
        class="tcover-chip"
      >
        <span class="tcover-no">{c.no}</span>
        <span class="font-medium">{c.name}</span>
        <span set:html={dots(c.elements)} />
        <span class="tcover-total">{c.total}</span>
      </button>
    ))}
  </div>

  <div class="tcover-team mt-3 flex flex-wrap items-center gap-2">
    <span class="text-sm font-medium">{t.team}:</span>
    <span data-tc-chips class="flex flex-wrap gap-2"></span>
    <button type="button" data-tc-clear class="tcover-clear">{t.clear}</button>
  </div>
  <p class="tcover-max mt-1 hidden text-xs text-red-500">{t.maxReached}</p>

  <div data-tc-output>
    <h3 class="mt-6 mb-2 text-lg font-bold">{t.offHeading}</h3>
    <p class="mb-2 text-xs text-foreground/70">{t.legend}</p>
    <div class="stat-table-wrap">
      <table class="stat-table w-full text-sm">
        <thead>
          <tr>
            <th>{t.colDefender}</th><th>{t.colBest}</th><th>{t.colFrom}</th><th>{t.colStatus}</th>
          </tr>
        </thead>
        <tbody>
          {result.offense.map((o) => (
            <tr>
              <td class="whitespace-nowrap"><span set:html={dots([o.d])} /> <span class="font-medium">{elem(o.d)}</span></td>
              <td class="whitespace-nowrap font-semibold">{fmt(o.best)}</td>
              <td class="whitespace-nowrap">{o.from || t.none}</td>
              <td class="whitespace-nowrap" style={`color:${statusColor[o.status]}`}>{statusLabel[o.status]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 class="mt-6 mb-2 text-lg font-bold">{t.defHeading}</h3>
    <div class="stat-table-wrap">
      <table class="stat-table w-full text-sm">
        <thead>
          <tr>
            <th>{t.colAttacker}</th><th>{t.colWeak}</th><th>{t.colResist}</th>
          </tr>
        </thead>
        <tbody>
          {result.defense.map((d) => (
            <tr>
              <td class="whitespace-nowrap"><span set:html={dots([d.a])} /> <span class="font-medium">{elem(d.a)}</span></td>
              <td class="whitespace-nowrap">{d.weak.length ? d.weak.join(', ') : t.none}</td>
              <td class="whitespace-nowrap">{d.resist.length ? d.resist.join(', ') : t.none}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-1 text-xs text-foreground/60">{t.dualNote}</p>

    <div data-tc-sug>
      <h3 class="mt-6 mb-2 text-lg font-bold">{t.sugHeading}</h3>
      {result.sugOff.length === 0 && result.sugDef.length === 0 && (
        <p class="text-sm text-green-600">{t.allCovered}</p>
      )}
      {result.sugOff.map((s) => (
        <p class="mb-2 text-sm">
          {t.sugOff.replace('{elem}', elem(s.elem))}
          {s.picks.map((p) => <a href={pickHref(p.slug)} class="tcover-link">{p.name}</a>)}
        </p>
      ))}
      {result.sugDef.map((s) => (
        <p class="mb-2 text-sm">
          {t.sugDef.replace('{n}', String(s.n)).replace('{elem}', elem(s.elem))}
          {s.picks.map((p) => <a href={pickHref(p.slug)} class="tcover-link">{p.name}</a>)}
        </p>
      ))}
    </div>
  </div>

  <script type="application/json" data-tc-i18n set:html={JSON.stringify(clientI18n)} />
</div>

<script>
  import data from '~/data/teamCoverage.json';

  // Mirrors the frontmatter analysis above — kept in sync manually.
  type Member = { slug: string; name: string; no: string; elements: string[]; total: number };
  const matrix = data.matrix as Record<string, Record<string, number>>;
  const S = data.super as number, R = data.resisted as number;

  for (const root of document.querySelectorAll<HTMLElement>('[data-team-coverage]')) {
    const cfg = JSON.parse(root.querySelector('[data-tc-i18n]')!.textContent!);
    const { t, preset, pathPrefix } = cfg;
    const elem = (e: string) => cfg.elemMap[e] ?? e;
    const bySlug = new Map<string, Member>((data.creatures as Member[]).map((c) => [c.slug, c]));
    const ELEM_COLOR: Record<string, string> = {
      Fire: '#f97316', Water: '#3b82f6', Grass: '#22c55e', Lightning: '#eab308',
      Ice: '#38bdf8', Earth: '#b45309', Wind: '#2dd4bf', Light: '#cbd5e1', Dark: '#71717a',
    };
    const dots = (els: string[]) =>
      els.map((e) => `<span title="${e}" style="color:${ELEM_COLOR[e]}">●</span>`).join(' ');

    const grid = root.querySelector('[data-tc-grid]')!;
    const chips = root.querySelector('[data-tc-chips]')!;
    const output = root.querySelector('[data-tc-output]')!;
    const maxNote = root.querySelector('.tcover-max')!;
    let team: Member[] = [];

    const esc = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const href = (slug: string) => `${pathPrefix}${slug}/`;
    const link = (p: Member) => ` <a class="tcover-link" href="${href(p.slug)}">${esc(p.name)}</a>`;

    function renderTeamChips() {
      chips.innerHTML = team
        .map(
          (m) => `<span class="tcover-chip tcover-chip-on" data-remove="${m.slug}">
            <span class="tcover-no">${m.no}</span> ${esc(m.name)} ${dots(m.elements)}
            <button type="button" aria-label="${esc(m.name)} ✕" data-remove="${m.slug}">✕</button></span>`
        )
        .join('');
      for (const btn of grid.querySelectorAll<HTMLButtonElement>('[data-slug]')) {
        btn.setAttribute('aria-selected', team.some((m) => m.slug === btn.dataset.slug) ? 'true' : 'false');
      }
    }

    function analyze(t2: Member[]) {
      const offense = (data.elements as string[]).map((d) => {
        let best = 1, from = '';
        for (const m of t2) for (const a of m.elements) {
          const v = matrix[a][d];
          if (v > best) { best = v; from = m.name; }
        }
        return { d, best, from, status: best === S ? 'super' : best === R ? 'resisted' : 'neutral' };
      });
      const defense = (data.elements as string[]).map((a) => {
        const weak: string[] = [], resist: string[] = [];
        for (const m of t2) {
          if (m.elements.some((e) => matrix[a][e] === S)) weak.push(m.name);
          if (m.elements.some((e) => matrix[a][e] === R)) resist.push(m.name);
        }
        return { a, weak, resist };
      });
      const inTeam = new Set(t2.map((m) => m.slug));
      const top = (cs: Member[]) => [...cs].sort((x, y) => y.total - x.total).slice(0, 3);
      const roster = data.creatures as Member[];
      const sugOff = offense
        .filter((o) => o.best < S)
        .map((o) => ({ d: o.d, picks: top(roster.filter((c) => !inTeam.has(c.slug) && c.elements.some((a) => matrix[a][o.d] === S))) }));
      const sugDef = defense
        .filter((d) => d.weak.length >= 2)
        .map((d) => ({ a: d.a, n: d.weak.length, picks: top(roster.filter((c) => !inTeam.has(c.slug) && c.elements.some((e) => matrix[d.a][e] === R))) }));
      return { offense, defense, sugOff, sugDef };
    }

    function renderOutput() {
      if (team.length === 0) {
        output.innerHTML = `<p class="text-sm text-foreground/70">${esc(t.emptyTeam)}</p>`;
        renderTeamChips();
        return;
      }
      const r = analyze(team);
      const stColor: Record<string, string> = { super: '#22c55e', neutral: '#eab308', resisted: '#ef4444' };
      const stLabel: Record<string, string> = { super: t.super, neutral: t.neutral, resisted: t.resisted };
      const offRows = r.offense
        .map(
          (o) => `<tr>
            <td class="whitespace-nowrap">${dots([o.d])} <span class="font-medium">${esc(elem(o.d))}</span></td>
            <td class="whitespace-nowrap font-semibold">${o.best}×</td>
            <td class="whitespace-nowrap">${o.from ? esc(o.from) : esc(t.none)}</td>
            <td class="whitespace-nowrap" style="color:${stColor[o.status]}">${stLabel[o.status]}</td>
          </tr>`
        )
        .join('');
      const defRows = r.defense
        .map(
          (d) => `<tr>
            <td class="whitespace-nowrap">${dots([d.a])} <span class="font-medium">${esc(elem(d.a))}</span></td>
            <td class="whitespace-nowrap">${d.weak.length ? esc(d.weak.join(', ')) : esc(t.none)}</td>
            <td class="whitespace-nowrap">${d.resist.length ? esc(d.resist.join(', ')) : esc(t.none)}</td>
          </tr>`
        )
        .join('');
      let sugHtml = '';
      if (r.sugOff.length === 0 && r.sugDef.length === 0) {
        sugHtml = `<p class="text-sm" style="color:#16a34a">${esc(t.allCovered)}</p>`;
      } else {
        sugHtml = r.sugOff
          .map((s) => `<p class="mb-2 text-sm">${esc(t.sugOff.replace('{elem}', elem(s.d)))}${s.picks.map(link).join('')}</p>`)
          .join('');
        sugHtml += r.sugDef
          .map((s) => `<p class="mb-2 text-sm">${esc(t.sugDef.replace('{n}', String(s.n)).replace('{elem}', elem(s.a)))}${s.picks.map(link).join('')}</p>`)
          .join('');
      }
      output.innerHTML = `
        <h3 class="mt-6 mb-2 text-lg font-bold">${esc(t.offHeading)}</h3>
        <p class="mb-2 text-xs text-foreground/70">${esc(t.legend)}</p>
        <div class="stat-table-wrap"><table class="stat-table w-full text-sm">
          <thead><tr><th>${esc(t.colDefender)}</th><th>${esc(t.colBest)}</th><th>${esc(t.colFrom)}</th><th>${esc(t.colStatus)}</th></tr></thead>
          <tbody>${offRows}</tbody></table></div>
        <h3 class="mt-6 mb-2 text-lg font-bold">${esc(t.defHeading)}</h3>
        <div class="stat-table-wrap"><table class="stat-table w-full text-sm">
          <thead><tr><th>${esc(t.colAttacker)}</th><th>${esc(t.colWeak)}</th><th>${esc(t.colResist)}</th></tr></thead>
          <tbody>${defRows}</tbody></table></div>
        <p class="mt-1 text-xs text-foreground/60">${esc(t.dualNote)}</p>
        <div><h3 class="mt-6 mb-2 text-lg font-bold">${esc(t.sugHeading)}</h3>${sugHtml}</div>`;
      renderTeamChips();
    }

    grid.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-slug]');
      if (!btn) return;
      const slug = btn.dataset.slug!;
      const member = bySlug.get(slug);
      if (!member) return;
      const idx = team.findIndex((m) => m.slug === slug);
      if (idx >= 0) {
        team.splice(idx, 1);
      } else if (team.length >= 6) {
        maxNote.classList.remove('hidden');
        return;
      } else {
        team.push(member);
      }
      maxNote.classList.add('hidden');
      renderOutput();
    });

    chips.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-remove]');
      if (!btn) return;
      team = team.filter((m) => m.slug !== btn.dataset.remove);
      renderOutput();
    });

    root.querySelector('[data-tc-clear]')!.addEventListener('click', () => {
      team = [];
      renderOutput();
    });

    root.querySelector('[data-tc-search]')!.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      for (const btn of grid.querySelectorAll<HTMLButtonElement>('[data-slug]')) {
        btn.style.display = !q || btn.dataset.name!.includes(q) ? '' : 'none';
      }
    });

    team = (preset as string[]).map((s) => bySlug.get(s)!).filter(Boolean);
    renderOutput();
  }
</script>

<style>
  .tcover-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.4rem;
    max-height: 18rem; overflow-y: auto; padding: 0.1rem;
    border: 1px solid hsl(var(--border) / 0.6); border-radius: 0.5rem;
  }
  .tcover-chip {
    display: flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.5rem;
    font-size: 0.8rem; text-align: left; border-radius: 0.375rem;
    border: 1px solid hsl(var(--border) / 0.5); background: hsl(var(--card));
    cursor: pointer; line-height: 1.2;
  }
  .tcover-chip:hover { border-color: hsl(var(--brand)); }
  .tcover-chip[aria-selected='true'] {
    border-color: hsl(var(--brand)); background: hsl(var(--brand) / 0.12); font-weight: 600;
  }
  .tcover-chip-on { cursor: default; }
  .tcover-chip-on button { margin-left: auto; opacity: 0.6; cursor: pointer; }
  .tcover-chip-on button:hover { opacity: 1; color: #ef4444; }
  .tcover-no { font-size: 0.7rem; opacity: 0.55; }
  .tcover-total { margin-left: auto; font-size: 0.7rem; opacity: 0.55; }
  .tcover-clear {
    font-size: 0.75rem; padding: 0.15rem 0.6rem; border-radius: 0.375rem;
    border: 1px solid hsl(var(--border) / 0.6); cursor: pointer; background: transparent;
  }
  .tcover-clear:hover { border-color: #ef4444; color: #ef4444; }
  .tcover-link { text-decoration: underline; text-underline-offset: 2px; margin-right: 0.35rem; }
</style>
