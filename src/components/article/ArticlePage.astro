---
/**
 * Article detail page.
 *
 * Behavior (PRD §9.3): single article falls back to English if locale version
 * missing — direct URL access never 404s.
 *
 * Renders:
 *   - H1 from entry.data.title (the MDX body must NOT contain an H1)
 *   - breadcrumb
 *   - rendered MDX body
 *   - related articles (by shared tags)
 *   - Article + BreadcrumbList JSON-LD
 */
import { Icon } from 'astro-icon/components';
import { render } from 'astro:content';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import InContentAd from '~/components/ads/InContentAd.astro';
import ArticleCtaCard from '~/components/article/ArticleCtaCard.astro';
import Comments from '~/components/article/Comments.astro';
import WikiSidebar from '~/components/sidebar/WikiSidebar.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { siteUrl } from '~/config/site';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getAdjacentEntries, getRelatedEntries, parseEntryId, type WikiEntry, type ResolvedEntry } from '~/lib/content';
import { articleJsonLd, breadcrumbJsonLd, faqPageJsonLd, pageTitle } from '~/lib/seo';
import { extractHeadings } from '~/lib/toc';
import { listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  resolved: ResolvedEntry;
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, resolved, alternates = [] } = Astro.props;
const { entry, servedLocale, isFallback } = resolved;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared as Record<string, string>;
const overview = (ui.overview as Record<string, { overviewTitle: string }>)[entry.data.category];
const navItem = NAVIGATION_CONFIG.find((n) => n.key === entry.data.category);

const parsed = parseEntryId(entry.id);
const slug = parsed?.slug ?? '';
const category = entry.data.category;
const categoryLabel = overview?.overviewTitle ?? nav[category] ?? category;

const coverUrl = entry.data.image
  ? `${siteUrl}${entry.data.image.src}`
  : `${siteUrl}/images/hero.webp`;

const related = await getRelatedEntries(entry, locale, 6);
const adjacent = await getAdjacentEntries(entry, locale);
const headings = extractHeadings(entry.body);

const { Content } = await render(entry);

// Typed as Record<string, unknown>[] (matching the layouts' jsonLd prop) so the
// array can hold article, breadcrumb AND FAQPage objects — TS would otherwise
// infer the element type from just the first two entries.
const jsonLd: Record<string, unknown>[] = [
  articleJsonLd({
    title: entry.data.title,
    description: entry.data.description,
    image: coverUrl,
    datePublished: entry.data.date,
    dateModified: entry.data.lastModified,
    category,
    slug,
    locale,
  }),
  breadcrumbJsonLd({
    category,
    categoryLabel,
    title: entry.data.title,
    slug,
    locale,
  }),
];
if (entry.data.faq && entry.data.faq.length > 0) {
  jsonLd.push(faqPageJsonLd(entry.data.faq));
}
---

<LocaleLayout
  locale={locale}
  title={pageTitle(entry.data.title)}
  description={entry.data.description}
  image={coverUrl}
  alternates={alternates}
  article={true}
  jsonLd={jsonLd}
>
  <div class="flex gap-8">
    <article class="mx-auto min-w-0 max-w-3xl flex-1">
    {/* Breadcrumb */}
    <nav class="text-sm text-muted-foreground" aria-label="breadcrumb">
      <a href="/" class="hover:text-nav">{nav.home}</a>
      <span class="mx-1">/</span>
      <a href={listPath(category, locale)} class="hover:text-nav">{categoryLabel}</a>
    </nav>

    {/* Header */}
    <header class="mt-3" data-pagefind-meta={`category:${category}`}>
      <div class="flex items-center gap-2">
        {navItem && <Icon name={navItem.icon} class="h-5 w-5 text-nav" />}
        <span class="text-sm font-medium uppercase tracking-wider text-foreground">{categoryLabel}</span>
      </div>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl" data-pagefind-meta={`title:${entry.data.title}`}>{entry.data.title}</h1>
      <p class="mt-3 text-muted-foreground">{entry.data.description}</p>
      <div class="mt-4 flex items-center gap-4 text-xs text-muted-foreground">
        <span class="inline-flex items-center gap-1">
          <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
          {entry.data.date.toLocaleDateString(locale)}
        </span>
        {
          entry.data.lastModified && (
            <span class="inline-flex items-center gap-1">
              <Icon name="lucide:refresh-cw" class="h-3.5 w-3.5" />
              {shared.lastUpdated}: {entry.data.lastModified.toLocaleDateString(locale)}
            </span>
          )
        }
        {
          isFallback && servedLocale !== locale && (
            <span class="inline-flex items-center gap-1 rounded-full bg-muted px-2 py-0.5">
              <Icon name="lucide:alert-circle" class="h-3 w-3" />
              English fallback
            </span>
          )
        }
      </div>
    </header>

    {/* Mobile TOC — collapsible, zero JS. Desktop TOC lives in the sidebar. */}
    {
      headings.length > 1 && (
        <details class="mt-4 rounded-lg border bg-card md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm font-medium text-muted-foreground">
            <Icon name="lucide:list" class="h-4 w-4" />
            {shared.toc}
          </summary>
          <ul class="space-y-1 border-t border-border px-4 py-3">
            {headings.map((h) => (
              <li>
                <a
                  href={`#${h.id}`}
                  class:list={[
                    'block text-sm text-muted-foreground transition hover:text-foreground',
                    h.depth === 3 && 'pl-3',
                  ]}
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    {/* Body */}
    <div
      class="prose prose-lg mt-8 max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-a:text-nav"
      data-pagefind-body
    >
      <Content />
    </div>

    {/* Tags */}
    {
      entry.data.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {entry.data.tags.map((tag: string) => (
            <span class="inline-flex items-center gap-1 rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">
              <Icon name="lucide:hash" class="h-3 w-3" />
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {/* Interlink matrix — hub links (tier list / type chart / dex / codes) */}
    <ArticleCtaCard locale={locale} category={category} slug={slug} />

    {/* In-content ad right after the article body + CTA (before comments and
        related articles) — placed at the very bottom almost nobody reached it.
        728×90 only from lg: between 768–1207px the content column is narrower
        than the banner, so the 300×250 serves that range instead. */}
    <div class="hidden lg:block">
      <InContentAd type="banner-728x90" label={shared.adLabel} />
    </div>
    <div class="lg:hidden">
      <InContentAd type="banner-300x250" label={shared.adLabel} />
    </div>

    {/* Comments — env empty = component renders nothing, no conditional needed */}
    <Comments locale={locale} />

    {/* Prev/next within the same category */}
    {
      (adjacent.prev || adjacent.next) && (
        <nav class="mt-8 grid gap-3 border-t border-border pt-6 sm:grid-cols-2" aria-label="Article pagination">
          {adjacent.prev
            ? (() => {
                const p = adjacent.prev!;
                const pSlug = parseEntryId(p.id)?.slug ?? '';
                return (
                  <a
                    href={detailPath(p.data.category, pSlug, locale)}
                    class="rounded-lg border bg-card p-3 transition hover:border-nav"
                  >
                    <span class="text-xs text-muted-foreground">← {shared.prevArticle}</span>
                    <span class="mt-1 block truncate text-sm font-medium">{p.data.title}</span>
                  </a>
                );
              })()
            : <span />}
          {adjacent.next
            ? (() => {
                const n = adjacent.next!;
                const nSlug = parseEntryId(n.id)?.slug ?? '';
                return (
                  <a
                    href={detailPath(n.data.category, nSlug, locale)}
                    class="rounded-lg border bg-card p-3 text-right transition hover:border-nav"
                  >
                    <span class="text-xs text-muted-foreground">{shared.nextArticle} →</span>
                    <span class="mt-1 block truncate text-sm font-medium">{n.data.title}</span>
                  </a>
                );
              })()
            : <span />}
        </nav>
      )
    }

    {/* Related */}
    {
      related.length > 0 && (
        <section class="mt-12 border-t border-border pt-8">
          <h2 class="text-xl font-bold">{shared.relatedArticles}</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {related.map((rel: WikiEntry) => {
              const relSlug = parseEntryId(rel.id)?.slug ?? '';
              const relCat = rel.data.category;
              return (
                <a href={detailPath(relCat, relSlug, locale)} class="card p-4">
                  <p class="text-xs uppercase tracking-wider text-muted-foreground">{relCat}</p>
                  <h3 class="mt-1 text-sm font-semibold leading-snug">{rel.data.title}</h3>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

  </article>
    <WikiSidebar locale={locale} currentPath={Astro.url.pathname} headings={headings} />
  </div>
</LocaleLayout>
