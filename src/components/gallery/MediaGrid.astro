---
/**
 * Screenshot / key-art grid for the gallery pages.
 *
 * Static lists — files were mirrored from the Steam store page and the
 * official aniimo.com CDN into /images/gallery/ by Aniimo/fetch_media.py +
 * convert_media.py (2026-08-19). Each tile links to the full-size image
 * (wallpaper-friendly, opens in a new tab). Dimensions are hardcoded so the
 * browser can reserve layout space (zero CLS).
 */
interface Item {
  src: string;
  alt: string;
  w: number;
  h: number;
}

interface Props {
  variant: 'screenshots' | 'keyart';
}
const { variant } = Astro.props;

const pad = (i: number) => String(i).padStart(2, '0');

const items: Item[] =
  variant === 'screenshots'
    ? Array.from({ length: 11 }, (_, i) => ({
        src: `/images/gallery/screenshot-${pad(i + 1)}.webp`,
        alt: `Aniimo official gameplay screenshot ${pad(i +  1)}`,
        w: 1600,
        h: 900,
      }))
    : [
        { src: '/images/gallery/keyart-01.webp', alt: 'Aniimo official key art banner', w: 1920, h: 712 },
        { src: '/images/gallery/keyart-02.webp', alt: 'Aniimo official social banner art', w: 1500, h: 500 },
        { src: '/images/gallery/keyart-03.webp', alt: 'Aniimo official region key art wallpaper', w: 1920, h: 1080 },
        { src: '/images/gallery/keyart-04.webp', alt: 'Aniimo official region key art wallpaper', w: 1920, h: 1080 },
        { src: '/images/gallery/keyart-05.webp', alt: 'Aniimo official region key art wallpaper', w: 1920, h: 1080 },
        { src: '/images/gallery/keyart-06.webp', alt: 'Aniimo official region key art wallpaper', w: 1920, h: 1080 },
        { src: '/images/gallery/keyart-07.webp', alt: 'Aniimo official region key art wallpaper', w: 1920, h: 1080 },
        { src: '/images/gallery/keyart-08.webp', alt: 'Aniimo official region key art wallpaper', w: 1920, h: 1080 },
      ];
---

<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {items.map((it) => (
    <a href={it.src} target="_blank" rel="noopener" class="card block overflow-hidden p-0">
      <img
        src={it.src}
        alt={it.alt}
        width={it.w}
        height={it.h}
        loading="lazy"
        decoding="async"
        class="h-auto w-full"
      />
    </a>
  ))}
</div>
