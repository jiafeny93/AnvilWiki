---
/**
 * 94-creature avatar wall for the gallery pages.
 *
 * Data-driven from src/data/creatureGallery.json (regenerated by
 * Aniimo/gen_gallery_pages.py from the official wiki snapshot). Artwork is
 * official Pawprint Studio material mirrored under /images/creatures/ under
 * the fan-wiki fair-use convention — see the gallery page credit section.
 */
import gallery from '~/data/creatureGallery.json';
import { detailPath } from '~/lib/url';
import type { Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
  {gallery.map((c) => (
    <a
      href={detailPath('creatures', `aniimo-${c.slug}`, locale)}
      class="card group flex flex-col items-center gap-1 p-2"
      title={`No.${c.no} ${c.name} — ${c.elements.join(' / ')}`}
    >
      <img
        src={`/images/creatures/${c.slug}-avatar.webp`}
        alt={`${c.name} official Aniimo artwork`}
        width="128"
        height="128"
        loading="lazy"
        decoding="async"
        class="h-20 w-20 object-contain sm:h-24 sm:w-24"
      />
      <span class="w-full truncate text-center text-[11px] text-muted-foreground group-hover:text-nav">
        {c.name}
      </span>
    </a>
  ))}
</div>
