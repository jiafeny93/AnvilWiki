---
/**
 * AdBanner — renders a single ad slot via iframe isolation.
 *
 * Each ad format is a standalone HTML file in public/ads/*.html, each with
 * its own window.atOptions. This prevents multi-ad collision (PRD §10).
 *
 * The ad key is read from PUBLIC_AD_* env vars. When the key is empty,
 * the component renders nothing (return null) — beginners can deploy
 * with no ads configured and the site works fine.
 *
 * Ad network integration: see your ad network's publisher docs.
 */
interface Props {
  /** Ad slot identifier, matches a file in public/ads/<type>.html. */
  type:
    | 'banner-320x50'
    | 'banner-300x250'
    | 'banner-728x90'
    | 'banner-468x60'
    | 'sidebar-160x600'
    | 'sidebar-160x300';
  /** Load eagerly (above-the-fold ads) or lazily. */
  eager?: boolean;
  /** Extra classes for the wrapper. */
  class?: string;
}
const { type, eager = false, class: className = '' } = Astro.props;

// Extract dimensions from the type string.
const match = type.match(/(\d+)x(\d+)/);
const width = match ? parseInt(match[1], 10) : 300;
const height = match ? parseInt(match[2], 10) : 50;
---

<div class:list={['flex max-w-full items-center justify-center', className]}>
  {/* allow-top-navigation-by-user-activation: Adsterra direct-type creatives navigate
      the top frame on click. Without this flag the browser silently blocks them and
      banners render but clicks do nothing (issue found 2026-08-29). Script-driven
      redirects (hijack) stay blocked — they lack a user gesture. */}
  <iframe
    src={`/ads/${type}`}
    width={width}
    height={height}
    scrolling="no"
    loading={eager ? 'eager' : 'lazy'}
    style={`border:none; margin:0; padding:0; width:100%; max-width:${width}px; aspect-ratio:${width} / ${height};`}
    title={`advertisement ${type}`}
    aria-hidden="true"
    sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms allow-top-navigation-by-user-activation"></iframe>
</div>
